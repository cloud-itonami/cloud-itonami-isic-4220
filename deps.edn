{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout -- a standalone fork should override them
 ;; with git coordinates. `utilconstr.store` uses `langchain-store.core` for
 ;; the shared EDN-blob codec / identity-schema / entity field-spec
 ;; machinery (ADR-2607141600) instead of hand-rolling it. `utilconstr.
 ;; notify`'s real Resend/Twilio transports use only `java.net.http` + a
 ;; hand-rolled minimal JSON/form encoder (see ns docstring) -- no extra
 ;; HTTP/JSON library dependency. This actor is COORDINATION-ONLY (every
 ;; proposal effect is `:propose`) -- it deliberately has NO dependency on
 ;; `kotoba-lang/robotics` or `kotoba-lang/physics-2d`: it never simulates
 ;; or dispatches heavy-equipment/robot actions, only proposes, schedules,
 ;; flags and logs, all governor- and human-gated (see README).
 ;; `jp-go-digital-design-system` (デジタル庁デザインシステム / DADS) is this
 ;; workspace's BASE design system, consumed as a GIT dep (never :local/root --
 ;; see that repo's own deps.edn comment) so `utilconstr.render-html` can emit
 ;; its `<style>` block from `jp-go-dds.skin/dds+skin` instead of hand-writing
 ;; CSS. BUILD-TIME doc-generator dependency only: the actor itself (store /
 ;; advisor / governor / phase / operation / notify) never touches it.
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.com-junkawasaki/langchain-clj
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "utilconstr.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor graph
  ;; (deterministic, byte-identical across reruns).
  :render-html {:main-opts ["-m" "utilconstr.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
